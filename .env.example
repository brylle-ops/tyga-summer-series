# Copy this file to .env.local and fill in the values. Never commit .env.local or share it.

# Supabase — Project Settings → API Keys (README: "Set up Supabase")
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts sb_publishable_) — safe in the browser, RLS protects the data
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts sb_secret_) — server only, never share
SUPABASE_SECRET_KEY=

# Square — from https://developer.squareup.com/apps → your app → Credentials / Locations
# Start with sandbox (test cards, no real money). Switch to production for launch.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Square → Webhooks → your subscription: its signature key, and the exact notification URL
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# Member list sync from the TYG Dashboard (any long random string; the same value goes in the Apps Script)
MEMBER_SYNC_SECRET=
# Mindbody "Membership Status" values that count as active (comma separated, not case-sensitive)
ACTIVE_MEMBER_STATUSES=active
# Let people who aren't on the member list sign up (true / false)
ALLOW_NON_MEMBERS=true

# The app's address — Square and the sign-in email link send people back here
NEXT_PUBLIC_SITE_URL=http://localhost:3000
